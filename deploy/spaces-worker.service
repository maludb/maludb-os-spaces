[Unit]
Description=Spaces worker: scheduled messages, reminders, the outbox (email, texts through the kernel) and digests, dispatches to agents, page snapshots, retention, trash purge, export expiry, the search index's catch-up (one pass)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory={{APP_DIR}}
# One pass: the steps whose moment has come (bin/worker.php, slice 8). A pass that finds another still running exits at once (an advisory lock); a long one (a big import, a dispatch
# waiting on an agent) is given ten minutes, and the timer's next tick waits for it (a oneshot service is never started twice).
TimeoutStartSec=600
SyslogIdentifier=spaces-worker
ExecStart=/usr/bin/php {{APP_DIR}}/bin/worker.php
