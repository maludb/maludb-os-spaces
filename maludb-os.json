{
  "schema": "maludb-os.application/1",
  "catalog_key": "spaces",
  "name": "Spaces",
  "description": "The business's collaborative workspace — Notion and Slack in one, for people and for the OS's agents as members of the same rooms: spaces holding pages built from blocks, a wiki with owners and verification, databases with typed properties and six views (relations and rollups included), and channels with threads, reactions, pins, saved items, scheduled messages and reminders; direct and group messages; one search across all of it; page history; comments; a public page door; Markdown and Notion imports, Markdown/HTML/CSV exports. Agents are @mentioned and DM'd and answer in the thread through the kernel's chat endpoint; the Librarian keeps the wiki honest. A default of every install.",
  "business_area": "Operations",
  "category": "communication",
  "icon": "feather-layers",
  "version": "0.1.0",
  "criticality": "high",
  "vhost": {
    "label": "spaces",
    "document_root": "html",
    "internal_port_env": "APP_INTERNAL_PORT"
  },
  "database": {
    "suffix": "spaces",
    "migrations": "db",
    "roles": {
      "rw": "spaces_rw",
      "records_ro": "spaces_records_ro",
      "activity_ro": "spaces_activity_ro"
    }
  },
  "env": {
    "required": [
      "APP_NAME",
      "APP_URL",
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "MCP_RECORDS_DB_USER",
      "MCP_RECORDS_DB_PASSWORD",
      "MCP_ACTIVITY_DB_USER",
      "MCP_ACTIVITY_DB_PASSWORD",
      "APP_INTERNAL_PORT",
      "MCP_RECORDS_PORT",
      "MCP_ACTIVITY_PORT",
      "ACTION_TOKEN_KEY",
      "ACTIONS_RELAY_KEY",
      "OS_APPLICATION_TOKEN",
      "OS_INTERNAL_URL",
      "OS_LAUNCHER_URL",
      "APP_KEY",
      "MALUDB_API_URL",
      "MALUDB_API_TOKEN"
    ],
    "optional": [
      "MALUMAIL_API_KEY",
      "MALUMAIL_API_URL",
      "MAIL_FROM",
      "MAIL_FROM_NAME",
      "ATTACHMENT_MAX_BYTES",
      "SP_PUBLIC_BASE_URL",
      "SP_EMBED_HOSTS",
      "API_CORS_ORIGINS"
    ]
  },
  "services": [
    "deploy/spaces-records-mcp.service",
    "deploy/spaces-activity-mcp.service",
    "deploy/spaces-activity-ingest.service",
    "deploy/spaces-activity-ingest.timer",
    "deploy/spaces-directory-sync.service",
    "deploy/spaces-directory-sync.timer",
    "deploy/spaces-worker.service",
    "deploy/spaces-worker.timer"
  ],
  "endpoints": [
    {
      "name": "Web UI",
      "kind": "ui",
      "path": "/",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Health",
      "kind": "http_api",
      "path": "/api/v1/health",
      "auth_kind": "none",
      "agent_reachable": false
    },
    {
      "name": "Public page",
      "kind": "ui",
      "path": "/p/",
      "auth_kind": "token",
      "agent_reachable": false
    },
    {
      "name": "Records MCP",
      "kind": "mcp",
      "path": "/mcp/records",
      "auth_kind": "bearer",
      "agent_reachable": true
    },
    {
      "name": "Activity MCP",
      "kind": "mcp",
      "path": "/mcp/activity",
      "auth_kind": "bearer",
      "agent_reachable": true
    }
  ],
  "actions": {
    "manifest": "docs/spaces-action-manifest.md",
    "registry": "mcp/action_registry.json",
    "base_url_env": "APP_INTERNAL_PORT"
  },
  "skills": [
    "skills/spaces-basics",
    "skills/writing-pages",
    "skills/talking-in-channels",
    "skills/keeping-the-wiki",
    "skills/monday-wiki-report",
    "skills/thread-to-page",
    "skills/answer-from-the-wiki",
    "skills/summarise-a-channel"
  ],
  "sso": {
    "path": "/sso",
    "logout_path": "/sso/logout"
  },
  "directory": {
    "reads": true,
    "writes": false
  },
  "assistant": {
    "command_bar": true,
    "agent": "expert"
  },
  "shares": [
    {
      "tool": "pages_index",
      "description": "The pages the requesting application's expert agent may see: id, title, space, path, last edited, verification; a search by title (os.spaces-pages/1)",
      "scoped": false
    },
    {
      "tool": "page_markdown",
      "description": "One page as Markdown with its properties, as the requesting application's expert agent may see it (os.spaces-page/1)",
