[Unit]
Description=Spaces worker: scheduled messages, reminders, the outbox and digests, dispatches to agents, page snapshots, retention, trash purge, export expiry, the search index's catch-up — one pass a minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
